        "func":  "// ID8 â€“ gom % Ä‘á»™ sÃ¡ng (tá»« hÃ m ID5, má»—i 2 s) thÃ nh trung bÃ¬nh 60 s -\u003e báº£ng lux_readings\nif (msg.dev !== \u0027pomo-01\u0027 || typeof msg.payload !== \u0027number\u0027) return null;\nconst now = Date.now();\nconst a = context.get(\u0027acc\u0027) || { sum: 0, n: 0, start: now };\na.sum += msg.payload; a.n++;\nif (now - a.start \u003c 60000) { context.set(\u0027acc\u0027, a); return null; }\ncontext.set(\u0027acc\u0027, { sum: 0, n: 0, start: now });\nreturn {\n    table: \u0027lux_readings\u0027,\n    payload: { dev: msg.dev, ts: new Date(now).toISOString(), lux_avg: Math.round(a.sum / a.n * 10) / 10 }\n};",
