        "name":  "ID5 – nạp ngưỡng",
        "func":  "// ID5 – nạp ngưỡng vào flow context rồi báo hàm ID5 đặt lại slider (\u0027init\u0027)\nconst v = Array.isArray(msg.payload) \u0026\u0026 msg.payload[0] ? Number(msg.payload[0].value) : NaN;\nif (msg.statusCode === 200 \u0026\u0026 !isNaN(v)) {\n    flow.set(\u0027luxThreshold\u0027, v);\n    node.status({ fill: \u0027green\u0027, shape: \u0027dot\u0027, text: `ngưỡng ${v}% (Supabase)` });\n} else {\n    node.status({ fill: \u0027red\u0027, shape: \u0027dot\u0027, text: `lỗi đọc settings (${msg.statusCode}), dùng ${flow.get(\u0027luxThreshold\u0027) ?? 30}%` });\n}\nreturn { topic: \u0027init\u0027 };",
