        "id":  "k5lux0000000001",
        "type":  "function",
        "z":  "4b33b41269aa03b7",
        "name":  "ID5 – độ sáng phòng",
        "func":  "// Vào: link in \u0027lux\u0027 ({lux: ADC 0..4095} mỗi 2 s), slider ngưỡng (topic \u0027threshold\u0027), inject \u0027init\u0027\n// Ra: 1 = gauge %, 2 = ô Tình trạng, 3 = đặt lại slider lúc khởi động\nconst LUX_INVERT = true;   // module LDR: càng sáng ADC càng NHỎ -\u003e đảo. Che tay mà % TĂNG thì đổi thành false\n// ponytail: ánh xạ tuyến tính, cần hiệu chuẩn với đèn bàn thật\nlet thr = flow.get(\u0027luxThreshold\u0027) ?? 30;   // Task 3.K2 chuyển ngưỡng sang bảng settings\nif (msg.topic === \u0027init\u0027) return [null, null, { payload: thr }];\nif (msg.topic === \u0027threshold\u0027) {\n    thr = Number(msg.payload);\n    flow.set(\u0027luxThreshold\u0027, thr);\n} else {\n    const raw = msg.payload \u0026\u0026 msg.payload.lux;\n    if (typeof raw !== \u0027number\u0027) return null;\n    context.set(\u0027pct\u0027, Math.round(LUX_INVERT ? 100 - raw / 40.95 : raw / 40.95));\n}\nconst pct = context.get(\u0027pct\u0027);\nif (pct === undefined) return null;\nconst segments = [{ from: 0, color: \u0027#ea5353\u0027 }, { from: thr, color: \u0027#e6e600\u0027 }, { from: Math.min(100, thr + 30), color: \u0027#5cd65c\u0027 }];\nreturn [\n    { payload: pct, dev: msg.payload \u0026\u0026 msg.payload.dev, ui_update: { segments } },\n    { payload: pct \u003c thr ? `Thiếu sáng (${pct}% \u003c ngưỡng ${thr}%)` : \u0027Đủ sáng\u0027 },\n    null\n];",
