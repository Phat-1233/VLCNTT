    {
        "id":  "k1state00000001",
        "type":  "function",
        "z":  "4b33b41269aa03b7",
        "name":  "ID1 – trạng thái hộp",
        "outputs":  5,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [

                 ],
        "func":  "// Vào: link in \u0027state\u0027 (pomodoro/state) + inject \u0027clock\u0027 mỗi 1 giây\n// Ra: 5 ô chữ group Trạng thái hộp (Kết nối, Trạng thái, Môn, Chu kỳ, Thời gian còn lại)\nconst LABEL = { idle: \u0027Chờ bắt đầu\u0027, study: \u0027Đang học\u0027, break: \u0027Nghỉ giải lao\u0027, paused: \u0027Tạm dừng\u0027, done: \u0027Hoàn thành\u0027 };\nconst now = Date.now();\nif (msg.topic !== \u0027clock\u0027) {\n    context.set(\u0027last\u0027, msg.payload || {});\n    context.set(\u0027seen\u0027, now);\n}\nconst s = context.get(\u0027last\u0027);\nif (!s) return [{ payload: \u0027Chưa có tin\u0027 }, null, null, null, null];\nconst ago = Math.floor((now - context.get(\u0027seen\u0027)) / 1000);\n// Hộp gửi nhịp tim \u0027tick\u0027 mỗi 30 s -\u003e quá 70 s không có tin là Offline\nconst online = ago \u003c 70;\nconst running = s.state === \u0027study\u0027 || s.state === \u0027break\u0027;\nconst remain = running ? Math.max(0, (s.remain || 0) - ago) : (s.remain || 0);\nconst mm = String(Math.floor(remain / 60)).padStart(2, \u00270\u0027);\nconst ss = String(remain % 60).padStart(2, \u00270\u0027);\nreturn [\n    { payload: online ? \u0027Online\u0027 : `Offline (${Math.floor(ago / 60)} phút trước)` },\n    { payload: LABEL[s.state] || s.state },\n    { payload: s.subject || \u0027—\u0027 },\n    { payload: s.cycle ? `${s.cycle} / ${s.total}` : `— / ${s.total}` },\n    { payload: `${mm}:${ss}` }\n];",
        "x":  420,
        "y":  460,
        "wires":  [
                      [
                          "19d5b02feebf0df5"
                      ],
                      [
                          "8625ac9901618927"
                      ],
                      [
                          "ad7ae89765730c36"
                      ],
                      [
                          "0c44a75939067152"
                      ],
                      [
                          "42ed03e27785dc85"
                      ]
                  ]
    },
    {
        "id":  "k1log000000001",
        "type":  "function",
        "z":  "4b33b41269aa03b7",
        "name":  "ID1 – nhật ký hôm nay",
        "outputs":  1,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [

                 ],
        "func":  "// Vào: link in \u0027session\u0027 (pomodoro/session, 1 bản tin = 1 chu kỳ học)\n// Ra: bảng Nhật ký học hôm nay. Lưu trong bộ nhớ Node-RED; Task 4.K3 đổi sang đọc bảng sessions (Supabase).\nconst p = msg.payload || {};\nif (!p.start_ts) return null;\nconst today = new Date().toLocaleDateString(\u0027vi-VN\u0027);\nlet log = context.get(\u0027log\u0027);\nif (!log || log.day !== today) log = { day: today, rows: [] };\nconst t = new Date(p.start_ts * 1000);\nconst hhmm = String(t.getHours()).padStart(2, \u00270\u0027) + \u0027:\u0027 + String(t.getMinutes()).padStart(2, \u00270\u0027);\nconst pm = Math.round((p.pause_sec || 0) / 60);\nconst row = {\n    \u0027Giờ\u0027: hhmm,\n    \u0027Môn\u0027: p.subject || \u0027—\u0027,\n    \u0027Chu kỳ\u0027: `${p.cycle}/${p.total}`,\n    \u0027Thời lượng\u0027: `${p.focus_min}/${p.planned_min} phút`,\n    \u0027Tạm dừng\u0027: p.pauses ? `${p.pauses} lần (${pm} phút)` : \u0027Không\u0027,\n    \u0027Kết quả\u0027: p.completed ? \u0027Hoàn thành\u0027 : \u0027Bỏ dở\u0027,\n    _ts: p.start_ts\n};\n// Hộp gửi lại cùng 1 phiên (chưa có ack) -\u003e thay dòng cũ, không thêm trùng\nconst i = log.rows.findIndex(r =\u003e r._ts === p.start_ts);\nif (i \u003e= 0) log.rows[i] = row; else log.rows.push(row);\nlog.rows = log.rows.slice(-100);\ncontext.set(\u0027log\u0027, log);\nreturn { payload: log.rows.map(({ _ts, ...r }) =\u003e r) };",
        "x":  420,
        "y":  1532,
        "wires":  [
                      [
                          "72e1034525f775e2"
                      ]
                  ]
    },
