    {
        "id":  "k9low000000001",
        "type":  "function",
        "z":  "4b33b41269aa03b7",
        "name":  "ID5 – cảnh báo thiếu sáng",
        "func":  "// ID5 – cảnh báo thiếu sáng: đang học + % \u003c ngưỡng LIÊN TỤC 30 s -\u003e lời nhắc OLED + còi 2 tiếng + events low_light\n// Tối đa 1 lần / 5 phút. Vào: % độ sáng (đầu ra 1 hàm ID5, có msg.dev) và link in \u0027state\u0027.\nconst HOLD_MS = 30000, GAP_MS = 5 * 60000;\nconst now = Date.now();\nif (msg.topic === \u0027pomodoro/state\u0027 || (msg.payload \u0026\u0026 msg.payload.state)) {\n    if (msg.payload.dev === \u0027pomo-01\u0027) context.set(\u0027state\u0027, msg.payload.state);\n    return null;\n}\nif (msg.dev !== \u0027pomo-01\u0027 || typeof msg.payload !== \u0027number\u0027) return null;\nconst pct = msg.payload, thr = flow.get(\u0027luxThreshold\u0027) ?? 30;\nif (context.get(\u0027state\u0027) !== \u0027study\u0027 || pct \u003e= thr) {\n    context.set(\u0027since\u0027, null);\n    node.status({});\n    return null;\n}\nconst since = context.get(\u0027since\u0027) || now;\ncontext.set(\u0027since\u0027, since);\nnode.status({ fill: \u0027yellow\u0027, shape: \u0027ring\u0027, text: `thiếu sáng ${Math.round((now - since) / 1000)} s` });\nif (now - since \u003c HOLD_MS || now - (context.get(\u0027lastAlert\u0027) || 0) \u003c GAP_MS) return null;\ncontext.set(\u0027lastAlert\u0027, now);\nnode.status({ fill: \u0027red\u0027, shape: \u0027dot\u0027, text: `đã cảnh báo ${new Date(now).toLocaleTimeString(\u0027vi-VN\u0027)}` });\nreturn [\n    [{ payload: { type: \u0027msg\u0027, text: \u0027Phong thieu sang, hay bat den!\u0027, sec: 10 } },\n     { payload: { type: \u0027beep\u0027, times: 2 } }],\n    { table: \u0027events\u0027, payload: { dev: \u0027pomo-01\u0027, ts: new Date(now).toISOString(), type: \u0027low_light\u0027, detail: { pct, threshold: thr } } }\n];",
