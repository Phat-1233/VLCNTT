    "willPayload": "",
    "willMsg": {},
    "userProps": "",
    "sessionExpiry": ""
  },
  {
    "id": "c1",
    "type": "comment",
    "z": "tabPomo",
    "name": "① NHẬN từ ESP32: pomodoro/# (state, lux, session)",
    "info": "",
    "x": 230,
    "y": 40,
    "wires": []
  },
  {
    "id": "mqttIn",
    "type": "mqtt in",
    "z": "tabPomo",
    "name": "pomodoro/#",
    "topic": "pomodoro/#",
    "qos": "1",
    "datatype": "json",
    "broker": "brokerHive",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 120,
    "y": 100,
    "wires": [
      [
        "dbgAll",
        "swTopic"
      ]
    ]
  },
  {
    "id": "dbgAll",
    "type": "debug",
    "z": "tabPomo",
    "name": "Tất cả bản tin",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "statusVal": "",
    "statusType": "auto",
    "x": 340,
    "y": 60,
    "wires": []
  },
  {
    "id": "swTopic",
    "type": "switch",
    "z": "tabPomo",
    "name": "Chia theo topic",
    "property": "topic",
    "propertyType": "msg",
    "rules": [
      {
        "t": "eq",
        "v": "pomodoro/state",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "pomodoro/lux",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "pomodoro/session",
        "vt": "str"
      }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 3,
    "x": 340,
    "y": 120,
    "wires": [
      [
        "dbgState"
      ],
      [
        "dbgLux"
      ],
      [
        "dbgSession"
      ]
    ]
  },
  {
    "id": "dbgState",
    "type": "debug",
    "z": "tabPomo",
    "name": "state → ID1 dashboard, ID6 Telegram, ID8 events (Khoa)",
    "active": false,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload.state",
    "statusType": "msg",
    "x": 680,
    "y": 80,
    "wires": []
  },
  {
    "id": "dbgLux",
