    "disabled": false,
    "info": "Giai đoạn 1–2: kiểm tra ESP32 <-> HiveMQ <-> Node-RED.\nSau khi import: mở node cấu hình 'HiveMQ Cloud', sửa Server và tab Security (user/pass nodered)."
  },
  {
    "id": "tlsHive",
    "type": "tls-config",
    "name": "HiveMQ TLS",
    "cert": "",
    "key": "",
    "ca": "",
    "certname": "",
    "keyname": "",
    "caname": "",
    "servername": "",
    "verifyservercert": true,
    "alpnprotocol": ""
  },
  {
    "id": "brokerHive",
    "type": "mqtt-broker",
    "name": "HiveMQ Cloud",
    "broker": "xxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud",
    "port": "8883",
    "tls": "tlsHive",
    "clientid": "",
    "autoConnect": true,
    "usetls": true,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
