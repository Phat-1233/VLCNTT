    "active": false,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 630,
    "y": 160,
    "wires": []
  },
  {
    "id": "c2",
    "type": "comment",
    "z": "tabPomo",
    "name": "② GỬI xuống ESP32: pomodoro/cmd (ID2 lời nhắn, đổi môn – ID10 beep) – Phát",
    "info": "Bấm nút bên trái các node inject để thử.\nSau này thay inject bằng ui-text-input / ui-dropdown / ui-button của Dashboard 2.0.",
    "x": 330,
    "y": 240,
    "wires": []
  },
  {
    "id": "injMsg",
    "type": "inject",
    "z": "tabPomo",
    "name": "Thử lời nhắn",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "Con nhớ ăn cơm rồi học tiếp nhé",
    "payloadType": "str",
    "x": 130,
    "y": 300,
    "wires": [
      [
        "fnMsg"
      ]
    ]
  },
  {
    "id": "fnMsg",
    "type": "function",
    "z": "tabPomo",
    "name": "ID2 – đóng gói lời nhắn (bỏ dấu)",
    "func": "const boDau = s => String(s).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D');\nmsg.payload = { type: 'msg', text: boDau(msg.payload).slice(0, 150), sec: 10 };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 300,
    "wires": [
      [
        "mqttOut"
      ]
    ]
  },
  {
    "id": "injSub",
    "type": "inject",
    "z": "tabPomo",
    "name": "Thử đổi môn: Toán",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "Toán",
    "payloadType": "str",
    "x": 140,
    "y": 350,
    "wires": [
      [
        "fnSub"
      ]
    ]
  },
  {
    "id": "fnSub",
    "type": "function",
    "z": "tabPomo",
    "name": "ID2 – đóng gói đổi môn (bỏ dấu)",
    "func": "const boDau = s => String(s).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D');\nmsg.payload = { type: 'subject', name: boDau(msg.payload).slice(0, 22) };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 350,
    "wires": [
      [
        "mqttOut"
      ]
    ]
  },
  {
    "id": "injBeep",
    "type": "inject",
    "z": "tabPomo",
    "name": "Thử Nhắc nhở (beep)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "3",
    "payloadType": "num",
    "x": 140,
    "y": 400,
    "wires": [
      [
        "fnBeep"
      ]
    ]
  },
  {
    "id": "fnBeep",
    "type": "function",
    "z": "tabPomo",
    "name": "ID10 – lệnh kêu còi",
    "func": "msg.payload = { type: 'beep', times: Number(msg.payload) || 3 };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 400,
    "wires": [
      [
        "mqttOut"
      ]
    ]
  },
  {
